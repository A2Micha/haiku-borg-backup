PORT=8081
APP_SECRET=replace-with-a-long-random-secret
MOCK_BORG=0
TZ=Europe/Berlin

# Read-only backup sources from the Docker host.
# Example: / exposes the full host filesystem below /host inside the container.
HOST_ROOT=/

# Writable destination root for LOCAL Borg repositories on the Docker host.
# A repository created as /repos/server-main in the UI will physically be created as:
#   ${BORG_REPO_ROOT}/server-main
# Example for a dedicated backup disk:
BORG_REPO_ROOT=/mnt/backup/borg
