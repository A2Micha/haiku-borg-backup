PORT=8081
APP_SECRET=replace-with-a-long-random-secret
MOCK_BORG=0
TZ=Europe/Berlin

# Read-only backup sources from the Docker host.
# Example: / exposes the full host filesystem below /host inside the container.
# Host paths entered in the UI (for example /etc) are mapped to /host/etc.
HOST_ROOT=/

# Writable destination root for LOCAL Borg repositories on the Docker host.
# Prefer an ABSOLUTE path. Example:
#   UI /mnt/backup/borg/server-main -> container /repos/server-main
#   physical host path             -> /mnt/backup/borg/server-main
BORG_REPO_ROOT=/mnt/backup/borg

# Borg waits this many seconds for repository locks before failing.
BORG_LOCK_WAIT=60

# Dashboard repository statistics are cached to avoid hammering large repos.
METRICS_TTL=300
METRICS_CONCURRENCY=2
